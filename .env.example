# Browser values only. Keep Supabase RLS enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets: Supabase Dashboard > Edge Functions > Secrets.
# Never use VITE_ prefixes for credentials.
# Gemini owns channel strategy, recipe planning, subtitle/caption generation, and AI Studio TTS.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Modal hosts the open-source video model and performs GPU inference.
# Deploy modal/video_worker.py with the Modal CLI first, then copy its authenticated submit-video URL.
# Set the following in Supabase Edge Function Secrets, never in .env.local/browser code:
# MODAL_VIDEO_ENDPOINT_URL=
# MODAL_KEY=wk-...        # Modal proxy token ID
# MODAL_SECRET=ws-...     # matching Modal proxy token secret

# Create this named secret in Modal (Modal Dashboard > Secrets):
# Name: cuto-supabase-worker
# Values: SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#         SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET
#         HF_TOKEN=YOUR_HUGGINGFACE_TOKEN_IF_THE_MODEL_REQUIRES_ACCEPTED_ACCESS

# The Modal worker uses Lightricks/LTX-2.5-Diffusers by default.
# Review and accept the model's applicable license terms before commercial use.
# The model may synthesize audio too, but CUTO's narration track comes from Gemini TTS.
# The Modal GPU worker uses FFmpeg to compose portrait MP4, subtitles, voice, and channel identity.
