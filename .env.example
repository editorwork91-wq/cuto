# Public browser configuration only. These values are safe to expose only when RLS is configured correctly.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets: Supabase Dashboard > Edge Functions > Secrets.
# NEVER add secrets to VITE_ variables, .env.local, the frontend bundle, or source control.
# The same Gemini key is used by currently implemented text-planning and TTS functions.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Intended AI-only video path: Veo generates every scene from prompts.
# This is a model ID, not an API key. Confirm model availability and billing for your Google project.
# GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# Optional render-provider secrets for composing AI-generated clips, voice, subtitles, and watermark.
# These are NOT wired into the current app until a renderer integration is implemented and deployed.
# Rendering keys must never be exposed to the browser. No stock-footage provider is part of CUTO's video pipeline.
# CREATOMATE_API_KEY=
# CREATOMATE_TEMPLATE_ID=
