# Public browser configuration only. These values are safe to expose when RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets: set in Supabase Dashboard > Edge Functions > Secrets.
# NEVER add these to VITE_ variables or commit their real values.
# Keep these in Supabase Edge Function secrets only (not in .env.local or browser code).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# VIDEO_PROVIDER_API_KEY=
# VIDEO_PROVIDER=

# Optional provider secrets for the planned MP4 pipeline.
# These providers are NOT called by the current app until the rendering integration is implemented.
# Add real values only to Supabase Edge Functions > Secrets after the matching integration is deployed.
# PEXELS_API_KEY=
# CREATOMATE_API_KEY=
# CREATOMATE_TEMPLATE_ID=
# For an optional Veo-generated-scene path, use the existing GEMINI_API_KEY; no separate key is needed.
